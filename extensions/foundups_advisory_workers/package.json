{
    "name":  "foundups-fusion-worker",
    "displayName":  "Foundups\u00aeAgent",
    "description":  "Open a WSP_00/WSP_97 RedDog Architect advisory worker in a Cursor editor webview tab.",
    "version":  "0.3.67",
    "publisher":  "foundups",
    "icon":  "icon.png",
    "engines":  {
                    "vscode":  "^1.74.0"
                },
    "categories":  [
                       "Other"
                   ],
    "activationEvents":  [
                             "onCommand:foundupsFusion.open"
                         ],
    "main":  "./extension.js",
    "contributes":  {
                        "commands":  [
                                         {
                                             "command":  "foundupsFusion.open",
                                             "title":  "Foundups\u00aeAgent: Open",
                                             "category":  "FoundUps"
                                         }
                                     ],
                        "menus":  {
                                      "commandPalette":  [
                                                             {
                                                                 "command":  "foundupsFusion.open"
                                                             }
                                                         ],
                                      "editor/title":  [
                                                           {
                                                               "command":  "foundupsFusion.open",
                                                               "group":  "navigation@100"
                                                           }
                                                       ],
                                      "editor/title/context":  [
                                                                   {
                                                                       "command":  "foundupsFusion.open",
                                                                       "group":  "navigation@100"
                                                                   }
                                                               ]
                                  },
                        "configuration":  {
                                              "title":  "Foundups\u00aeAgent",
                                              "properties":  {
                                                                 "foundupsFusion.pythonPath":  {
                                                                                                   "type":  "string",
                                                                                                   "default":  "python",
                                                                                                   "description":  "Python executable used to call the redaction-gated OpenRouter bridge."
                                                                                               },
                                                                 "foundupsFusion.leadModel":  {
                                                                                                  "type":  "string",
                                                                                                  "default":  "z-ai/glm-5.2",
                                                                                                  "description":  "OpenRouter model slug for the principal/synthesis worker."
                                                                                              },
                                                                 "foundupsFusion.panelModels":  {
                                                                                                    "type":  "array",
                                                                                                    "default":  [
                                                                                                                    "deepseek/deepseek-v4-pro",
                                                                                                                    "moonshotai/kimi-k2.7-code"
                                                                                                                ],
                                                                                                    "items":  {
                                                                                                                  "type":  "string"
                                                                                                              },
                                                                                                    "description":  "OpenRouter model slugs for panel critics. The extension uses up to four."
                                                                                                }
                                                             }
                                          }
                    },
    "license":  "UNLICENSED",
    "homepage":  "https://github.com/FOUNDUPS/Foundups-Agent",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/FOUNDUPS/Foundups-Agent"
                   }
}
